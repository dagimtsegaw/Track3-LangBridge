# Required before GET /api/v1/escalations or the helper desk will list tickets.

HELPER_TOKEN=5d70d1a2189c7d7f0c74ed6af2f94577

# Local model on this machine. No key. Leave both empty to keep the model off.
# AI_PROVIDER=ollama uses these. From Docker, set the URL to http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Public Telegram bot username, without a secret.
# The widget builds https://t.me/<username> and adds ?start=<lang>_<topic> when a topic is chosen.
# data-telegram on the script tag overrides this. alxtestsbot is the default.
TELEGRAM_BOT_USERNAME=alxtestsbot
