BOT_TOKEN=

# Voice. Amharic, Afaan Oromo, Tigrinya, and Somali use Addis Voices.
# English and Arabic use Edge TTS and need no key.
# Without this key, Amharic and Somali fall back to Edge.
# Oromo and Tigrinya are read in English.
ADDIS_API_KEY=
ADDIS_BASE_URL=https://api.addisassistant.com

# auto tries offline NLLB when @huggingface/transformers is installed, then Google.
# google skips NLLB and uses Google Translate only.
TRANSLATOR=auto
NLLB_MODEL=Xenova/nllb-200-distilled-600M
